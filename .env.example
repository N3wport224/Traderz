# Traderz environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env` / `.env.local` /
# any file holding real credentials — git-ignored by design; see CLAUDE.md.
# Every variable here has a safe default baked into the code: an empty file
# (or no file at all) runs the system fully mocked with zero external calls.

# --- Market data source -------------------------------------------------------
# mock  -> simulated random-walk OHLCV streams (default; no network access)
# live  -> real market data: stock tickers (AAPL) poll Yahoo Finance's public
#          chart API; crypto pairs (BTC/USDT) poll public CCXT OHLCV candles.
#          Neither needs credentials — live *data* is free and read-only.
DATA_SOURCE_MODE=mock

# Initial watchlist symbol the engines subscribe to at boot. Change it at
# runtime from the dashboard's Asset Selector (POST /api/watchlist).
WATCHLIST_SYMBOL=MOCK

# CCXT exchange id used for live crypto data AND live order execution.
EXCHANGE_ID=binance

# --- Order execution (PAPER TRADING GUARD) ------------------------------------
# mock  -> MockExecutionGateway: simulated fills, slippage, fees, balances.
#          THIS IS THE PAPER-TRADING DEFAULT. Live market data + mock gateway
#          means the bot tracks real charts but risks no real capital.
# live  -> LiveCCXTExecutionGateway: REAL orders on a REAL exchange using the
#          credentials below. Only set this deliberately, with keys you intend
#          to trade with.
GATEWAY_MODE=mock

# Exchange API credentials — required ONLY when GATEWAY_MODE=live.
# Leave blank for paper trading. Real values belong in your untracked `.env`.
API_KEY=
API_SECRET=

# --- Operational risk guard (the financial seatbelt) ---------------------------
# Hard daily-loss lock: if realized PnL within one calendar day drops below
# -MAX_DAILY_LOSS_PCT of total capital, all open positions are flattened and
# every further entry is rejected until the next day (or an operator reset).
MAX_DAILY_LOSS_PCT=0.03

# Hard cap on entries per calendar day (runaway-loop / over-trading protection).
MAX_DAILY_TRADE_COUNT=50

# Manual master switch: true halts all entries from boot. Also flippable at
# runtime via POST /api/system/kill (and released via /api/system/guard/reset).
CIRCUIT_BREAKER_ACTIVE=false

# --- Backtesting ---------------------------------------------------------------
# Directory of historical CSVs ({SYMBOL}.csv with timestamp,open,high,low,close,
# volume). When a symbol has no CSV, /api/backtest replays a deterministic
# seeded synthetic history instead.
BACKTEST_DATA_DIR=data

# --- Persistence --------------------------------------------------------------
# Defaults to a local SQLite file (sqlite+aiosqlite:///./traderz.db).
# Point at Postgres to scale: postgresql+asyncpg://user:pass@host/dbname
#DATABASE_URL=

# --- Notifications ------------------------------------------------------------
# Discord-compatible incoming-webhook URL for BUY/SHORT/circuit-breaker and
# data-disconnect alerts. Unset -> console logging only.
#NOTIFIER_WEBHOOK_URL=

# --- Observability ------------------------------------------------------------
# Structured JSON-lines log destination (default: ./logging.json).
#LOG_JSON_PATH=logging.json
